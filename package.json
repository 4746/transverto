{
  "name": "@cli107/transverto",
  "description": "Generate automatically translations for your i18n json translate files",
  "homepage": "https://github.com/4746/transverto",
  "bugs": "https://github.com/4746/transverto/issues",
  "version": "2.0.0-beta.7",
  "license": "MIT",
  "keywords": [
    "transverto",
    "translate",
    "label",
    "json",
    "ctv",
    "label management",
    "translator"
  ],
  "author": "Vadim",
  "repository": "4746/transverto",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "type": "module",
  "scripts": {
    "build": "shx rm -rf dist && tsc",
    "lint": "eslint ./src ./test",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "prepare": "npm run build",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "test:e2e": "npm run build && node --test \"test/e2e/**/*.test.mjs\"",
    "version": "oclif readme",
    "win:delete:node_modules": "rd /s /q \"node_modules\"",
    "npm:cache:clean": "npm cache clean --force"
  },
  "bin": {
    "ctv": "./bin/run.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@json2csv/plainjs": "^7.0.7",
    "@oclif/core": "^4.13.2",
    "@oclif/plugin-help": "^6.2.56",
    "@oclif/table": "^0.5.9",
    "chalk": "^6.0.0",
    "fs-extra": "^11.4.0",
    "listr2": "^11.0.0"
  },
  "devDependencies": {
    "@oclif/prettier-config": "^0.2.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-oclif": "^6.0.179",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "oclif": "^4.23.29",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.15"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "main": "dist/index.js",
  "oclif": {
    "bin": "ctv",
    "dirname": "ctv",
    "commands": "./dist/commands",
    "scope": "@cli107",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": ":",
    "topics": {
      "label": {
        "description": "Label management command."
      },
      "cache": {
        "description": "Cache management command."
      },
      "init": {
        "description": "Create a default configuration file"
      }
    },
    "additionalVersionFlags": [
      "-v"
    ],
    "additionalHelpFlags": [
      "-h"
    ],
    "warn-if-update-available": {
      "timeoutInDays": 7
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
